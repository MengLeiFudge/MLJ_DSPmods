<Project>
    <PropertyGroup>
        <!-- 固定使用4.7.2版本 -->
        <TargetFramework>net472</TargetFramework>
        <!-- bepinex包源 -->
        <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
        <!-- 输出路径不按 OS 或目标框架拆分，确保本机 Debug 产物固定在 bin\Debug -->
        <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
        <BaseOutputPath>bin/</BaseOutputPath>
        <!-- 始终排除 obj 和 bin 目录，防止构建产物进入编译输入 -->
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
        <!-- 禁止在输出路径后追加框架名称 (如 net472) -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- 禁止追加运行时标识符 (如 win-x64)，让路径更短 -->
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <!-- 统一调试符号格式，确保跨平台一致性 -->
        <DebugType>portable</DebugType>
        <!-- 源码和编译参数不变时保持 DLL/PDB 字节稳定，避免无实质变化的重编译触发重复发布 -->
        <Deterministic>true</Deterministic>
        <!-- 不把当前 Git revision 写入 PDB SourceLink；否则只要 HEAD 变化，无关项目的 DLL/PDB 也会变化 -->
        <EnableSourceLink>false</EnableSourceLink>
        <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
        <!-- 使用最新语言特性 -->
        <LangVersion>latest</LangVersion>
        <!-- 不把当前 Git 提交号写进 AssemblyInformationalVersion，避免只改一个项目时全量重编译导致无关 DLL 字节变化 -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <!-- 使用x64平台 -->
        <PlatformTarget>x64</PlatformTarget>
        <!-- 允许不安全代码，配合publize的dll使用 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <!-- 用于生成实时调试需要的mdb文件 -->
        <DebugType>full</DebugType>
    </PropertyGroup>
</Project>
