###############################################################################
# 默认自动规范化换行符。
###############################################################################
* text=auto

###############################################################################
# 设置命令行 diff 的默认行为。
#
# 早期 msysgit 默认未对 C# 文件启用该行为，因此需要此设置。
# 注意：该设置仅供命令行使用。
###############################################################################
#*.cs     diff=csharp

###############################################################################
# 为项目文件和解决方案文件设置合并驱动。
#
# 从命令行合并时，冲突文件会包含 diff 标记（从 VS 合并不受下列设置影响，
# VS 不会插入 diff 标记）。这些标记可能导致下列文件无法加载。另一种方式
# 是取消对应规则的注释，把这些文件视为二进制；这样每次冲突都必须人工处理。
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# 图像文件的处理方式。
#
# 图像文件默认按二进制处理。
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# 常见文档格式的 diff 行为。
# 
# 比较前先把二进制文档格式转换为文本。该功能仅在命令行中可用；
# 需要启用时，请取消下列对应规则的注释。
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain
